# ==== Database ====
DB_NAME=arxivradar
DB_USER=arxivradar
# 生产必填。至少 16 位随机串。生成: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_16CHARS

# ==== Redis ====
# 生产必填。生成: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_16CHARS

# ==== CORS ====
# 逗号分隔,支持通配符。默认覆盖: surge.sh 前端 + 本地开发
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://arxiv-radar-demo.surge.sh
